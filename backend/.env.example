# Copy to backend/.env and fill in your key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Orchestrator LLM provider. Defaults to Anthropic using the key above, so an
# existing .env needs no changes.
#
# LLM_PROVIDER=anthropic   native SDK; keeps explicit prompt-cache breakpoints
# LLM_PROVIDER=openai      OpenAI-compatible /v1/chat/completions
#
# The orchestrator drives 8 tools with strict (extra="forbid") schemas. A model
# with weak tool-use ability will loop until MAX_TOOL_ITERATIONS rather than
# fail fast, so prefer models with solid function-calling support.

# --- DeepSeek ---
# Use deepseek-chat; the reasoner model's tool use is unreliable.
# LLM_PROVIDER=openai
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MAX_TOKENS=8192          # DeepSeek caps output at 8192; default is 16000

# --- Local model server (Ollama / vLLM / LM Studio) ---
# LLM_PROVIDER=openai
# LLM_MODEL=<model name the server exposes>
# LLM_API_KEY=not-needed       # most local servers ignore it, but one must be set
# LLM_BASE_URL=http://localhost:11434/v1

# ---------------------------------------------------------------------------
# Auth

# How long a login session cookie stays valid, in days.
SESSION_TTL_DAYS=30
# Set to true once the app is served over https — marks the session cookie
# Secure so browsers won't send it over plain http.
COOKIE_SECURE=false

# Failed logins permitted per email and per client IP within the window below.
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15

# Comma-separated browser origins allowed to call the API with credentials.
# Must list the real frontend origin in production. "*" is not valid here.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
